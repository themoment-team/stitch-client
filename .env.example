# AI 도안 생성에 사용하는 OpenAI API 키 (서버 전용, NEXT_PUBLIC_ 접두사를 붙이지 말 것)
OPENAI_API_KEY=
# 사용할 이미지 모델 (선택, 기본값 gpt-image-1)
OPENAI_IMAGE_MODEL=
# 최종 그림을 저장하는 Supabase (서버 전용, service role 키는 절대 클라이언트에 노출하지 말 것)
# 테이블은 supabase/schema.sql을 Supabase SQL Editor에서 실행해 생성
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 인쇄물 QR 코드에 넣을 사이트 주소 (선택, 기본값은 지금 접속한 주소)
# 로컬에서 폰으로 QR을 테스트할 때 PC의 IP를 넣음 (예: http://192.168.0.10:3000)
NEXT_PUBLIC_SITE_URL=
# Vercel이 아닌 곳에 배포할 때, 앞단 프록시(nginx 등)가 클라이언트 IP를 채우는 헤더 이름 (선택, 예: x-real-ip)
# 프록시가 이 헤더를 직접 덮어쓰거나 뒤에 덧붙이도록 설정한 경우에만 넣음. 비우면 IP별 한도를 모두 한 사람으로 셈
# Vercel에서는 무시하고 Vercel이 채우는 헤더를 씀
TRUSTED_IP_HEADER=
